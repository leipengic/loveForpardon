"""心形绘制与闪烁动画（turtle 版）。

改编自《打火机与公主裙》中的爱心代码。
运行方式：
    python B-loveForpardon
"""

import time
import turtle

BACKGROUND_COLOR = "black"
HEART_COLOR = "red"
BLINK_INTERVAL = 0.5  # 秒，闪烁频率
HEART_SIZE = 100


def draw_heart(pen: turtle.Turtle, size: int) -> None:
    """绘制一个实心心形。

    使用经典 turtle 心形画法：先左转 140 度，交替绘制两段圆弧，
    再回到起点，形成左右对称的心形。

    Args:
        pen: turtle 画笔对象
        size: 心形大小（控制整体尺寸）
    """
    pen.penup()
    pen.goto(0, -size / 2)
    pen.setheading(0)
    pen.pendown()
    pen.begin_fill()
    pen.left(140)
    pen.forward(size)
    pen.circle(-size / 2, 200)
    pen.left(120)
    pen.circle(-size / 2, 200)
    pen.forward(size)
    pen.end_fill()
    pen.penup()


def main() -> None:
    """初始化画布并循环闪烁显示心形。"""
    screen = turtle.Screen()
    screen.bgcolor(BACKGROUND_COLOR)
    screen.title("打火机与公主裙 · 爱心")

    pen = turtle.Turtle()
    pen.speed(0)
    pen.hideturtle()
    pen.color(HEART_COLOR)

    try:
        while True:
            pen.clear()
            draw_heart(pen, HEART_SIZE)
            screen.update()
            time.sleep(BLINK_INTERVAL)

            pen.clear()
            time.sleep(BLINK_INTERVAL / 2)
    except turtle.Terminator:
        # 窗口被关闭时正常退出
        pass


if __name__ == "__main__":
    main()
